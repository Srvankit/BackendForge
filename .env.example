# Compose execution: the backend reaches PostgreSQL by its Compose service name.
DB_URL=jdbc:postgresql://postgres:5432/backendforge
DB_USERNAME=backendforge
DB_PASSWORD=change-me

# Host execution against the existing PostgreSQL container instead:
# DB_URL=jdbc:postgresql://localhost:5433/backendforge

# Compose PostgreSQL service settings.
POSTGRES_DB=backendforge
POSTGRES_USER=backendforge
POSTGRES_PASSWORD=change-me

SERVER_PORT=8080
JWT_SECRET=replace-with-a-base64-encoded-secret-at-least-32-bytes-long
JWT_EXPIRATION_SECONDS=900
JWT_ISSUER=backendforge
JWT_AUDIENCE=backendforge-api

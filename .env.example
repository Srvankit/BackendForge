# Compose execution: the backend reaches PostgreSQL by its Compose service name.
# Compose derives the backend connection from POSTGRES_DB, POSTGRES_USER,
# and POSTGRES_PASSWORD below.

# Host execution against the existing PostgreSQL container instead:
# DB_URL=jdbc:postgresql://localhost:5433/backendforge
# DB_USERNAME=backendforge
# DB_PASSWORD=change-me

# Compose PostgreSQL service settings.
POSTGRES_DB=backendforge
POSTGRES_USER=backendforge
POSTGRES_PASSWORD=change-me

SERVER_PORT=8080
JWT_SECRET=replace-with-a-base64-encoded-secret-at-least-32-bytes-long
JWT_EXPIRATION_SECONDS=900
JWT_ISSUER=backendforge
JWT_AUDIENCE=backendforge-api

# Per-instance public authentication request limits. Tune with load testing;
# these development defaults are not distributed production protection.
RATE_LIMIT_MAX_ENTRIES=10000
RATE_LIMIT_LOGIN_MAX_REQUESTS=30
RATE_LIMIT_LOGIN_WINDOW=60s
RATE_LIMIT_REGISTER_MAX_REQUESTS=30
RATE_LIMIT_REGISTER_WINDOW=60s
